# Copy to .env and fill in locally. Never commit .env.
# Existing deployments: set this to your existing Compose project name.
COMPOSE_PROJECT_NAME=paperflow
PAPERLESS_DB_PASSWORD=
PAPERLESS_SECRET_KEY=
PAPERLESS_URL=http://localhost:8000
PAPERFLOW_HTTP_PORT=8000
PAPERFLOW_BIND_ADDRESS=127.0.0.1
PAPERLESS_TIME_ZONE=UTC
PAPERLESS_OCR_LANGUAGE=eng

# Optional AI. Select a provider and models before enabling.
PAPERLESS_AI_ENABLED=false
PAPERLESS_AI_LLM_BACKEND=openai-like
PAPERLESS_AI_LLM_ENDPOINT=
PAPERLESS_AI_LLM_MODEL=
PAPERLESS_AI_LLM_API_KEY=
PAPERLESS_AI_LLM_EMBEDDING_BACKEND=openai-like
PAPERLESS_AI_LLM_EMBEDDING_ENDPOINT=
PAPERLESS_AI_LLM_EMBEDDING_MODEL=

# Optional Mistral OCR; use remote mode 'workflow_only' for workflow-only OCR.
PAPERLESS_MISTRAL_API_KEY=
PAPERLESS_MISTRAL_MODEL=mistral-ocr-latest
PAPERLESS_REMOTE_OCR_MODE=always

# Optional WebDAV: docker compose --profile webdav up -d
WEBDAV_USER=
WEBDAV_PASSWORD=
